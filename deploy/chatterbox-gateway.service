[Unit]
Description=Chatterbox dual inference gateway (trusted LAN)
After=chatterbox-web.service chatterbox-multilingual.service
[Service]
WorkingDirectory=/opt/chatterbox-web
ExecStart=/opt/chatterbox-web/.venv/bin/uvicorn dual_gateway:app --host 0.0.0.0 --port 8006 --workers 1
Restart=on-failure
RestartSec=15
[Install]
WantedBy=multi-user.target
